<?xml version="1.0" encoding="utf-8"?>
<!-- Experimental manifest: validates that Wren runs inside an MSIX container.
     Placeholders ({{...}}) are filled in by New-WrenMsix.ps1. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="{{NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Wren</DisplayName>
    <PublisherDisplayName>Wren</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Wren" Executable="{{EXE}}" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Wren"
        Description="Voice dictation that lives in the tray"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Replaces the registry Run key written by tauri-plugin-autostart,
             which is virtualized (invisible to Windows) inside the container. -->
        <uap5:Extension Category="windows.startupTask" Executable="{{EXE}}" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="WrenStartup" Enabled="false" DisplayName="Wren" />
        </uap5:Extension>
        <!-- `wren.exe` on PATH: lets tests pass args/env and exercise the
             hidden worker subcommand from outside the package. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="{{EXE}}" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="wren.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
